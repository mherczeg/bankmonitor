<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>hu.bankmonitor</groupId>
	<artifactId>global-payment-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>global-payment-service</name>
	<description>Payment gateway holding account balances and moving money between accounts</description>

	<properties>
		<java.version>21</java.version>
		<!--
		  springdoc 3.x is the Spring Boot 4 line: 3.1.0 is itself built against
		  spring-boot-starter-parent 4.1.0. The 2.x line targets Boot 3 and does
		  not work here. See OpenApiDocumentSpikeTest for the check that keeps
		  this honest rather than assumed.
		-->
		<springdoc.version>3.1.0</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		  Deliberately absent until something uses it: spring-boot-starter-validation,
		  and the -validation-test / -actuator-test slices. Nothing here validates a
		  request body yet; the first @Valid arrives with the account and transfer DTOs.

		  The rule this POM follows is that a dependency appears when a line of code
		  needs it. Worth stating explicitly because `mvn dependency:analyze` cannot
		  check it for you: starters are aggregator POMs carrying no classes of their
		  own, so it reports every one of them as "unused declared" whether it is or not.
		-->


		<!-- Serves /v3/api-docs, which ticket 32 turns into the frontend's API types. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!--
		  H2 runs the application and the test suite alike (design decision 25).
		  Testcontainers was rejected so that `./mvnw test` needs no Docker daemon.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
